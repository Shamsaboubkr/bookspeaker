<?xml version="1.0" encoding="UTF-8"?>
<!--
  Bookspeaker — WiX (Windows Installer) definition.

  Per-user install: no admin prompt, installs under %LOCALAPPDATA%\Bookspeaker.
  That matters for this app — an MSIX/container install would redirect
  %APPDATA% and hide the existing SQLite progress database.

  Version is injected at build time:  candle -dVersion=1.0.5 ...
  UpgradeCode must NEVER change between releases, or upgrades install side by side.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product Id="*"
           Name="Bookspeaker"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="Bookspeaker"
           UpgradeCode="7E2C1A64-5B3D-4A9E-8F17-9C4B6D2E5A31">

    <Package Id="*"
             Keywords="Installer"
             Description="Bookspeaker — local audiobook player with Drive progress sync"
             Comments="Listen everywhere. Pick up anywhere."
             Manufacturer="Bookspeaker"
             InstallerVersion="500"
             Compressed="yes"
             InstallScope="perUser"
             Platform="x64" />

    <!-- Replaces an older install instead of stacking; blocks downgrades. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Bookspeaker is already installed." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="bookspeaker.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/" />

    <!-- Windows 10 or newer (Flutter desktop requirement). -->
    <Condition Message="Bookspeaker needs Windows 10 or newer.">
      <![CDATA[Installed OR (VersionNT >= 603)]]>
    </Condition>

    <!-- Anything already there gets replaced on upgrade. -->
    <Property Id="ARPNOMODIFY" Value="1" />

    <Feature Id="MainFeature" Title="Bookspeaker" Level="1" Absent="disallow">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <UI>
      <UIRef Id="WixUI_Minimal" />
      <UIRef Id="WixUI_ErrorProgressText" />
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchApplication"
               Order="999">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>
    </UI>

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Bookspeaker" />
    <Property Id="WixShellExecTarget" Value="[#bookspeaker.exe]" />
    <CustomAction Id="LaunchApplication"
                  BinaryKey="WixCA"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />
  </Product>

  <!-- Directory layout: per-user, so everything lives under LOCALAPPDATA. -->
  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="CompanyFolder" Name="Bookspeaker">
          <Directory Id="INSTALLFOLDER" Name="Bookspeaker" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppShortcutFolder" Name="Bookspeaker" />
      </Directory>
    </Directory>
  </Fragment>

  <!--
    Start Menu shortcut. The bookspeaker.exe file itself is added by heat.exe
    (see the workflow), so this component deliberately contains no files of its
    own; the registry key makes it a valid, removable component.
  -->
  <Fragment>
    <DirectoryRef Id="AppShortcutFolder">
      <Component Id="ApplicationShortcut" Guid="2C7E4B19-8D5A-4F36-B1E4-73A9C0D6F852">
        <Shortcut Id="StartMenuShortcut"
                  Name="Bookspeaker"
                  Description="Listen everywhere. Pick up anywhere."
                  Target="[INSTALLFOLDER]bookspeaker.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RemoveFolder Id="RemoveAppShortcutFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\Bookspeaker"
                       Name="startMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

</Wix>
